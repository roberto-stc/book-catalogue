{% extends 'base.twig' %}
{% block title %}Add a Book{% endblock %}
{% block content %}

<div class="row justify-content-center">
<div class="col-md-8 col-lg-6">
<div class="card p-4">

<h1 class="h3 mb-3">Add a Book</h1>

{% if message %}
<div class="alert alert-warning">{{ message|e }}</div>
{% endif %}

<form method="post">
<div class="mb-3">
<label class="form-label" for="title">Title</label>
<input class="form-control" type="text" id="title" name="title">
</div>
<div class="mb-3">
<label class="form-label" for="author">Author</label>
<input class="form-control" type="text" id="author" name="author">
</div>
<div class="mb-3">
<label class="form-label" for="genre">Genre</label>
<input class="form-control" type="text" id="genre" name="genre">
</div>
<div class="mb-4">
<label class="form-label" for="year">Year</label>
<input class="form-control" type="number" id="year" name="year">
</div>
<button class="btn btn-primary" type="submit">Save</button>
<a class="btn btn-outline-secondary" href="index.php">Cancel</a>
</form>

</div>
</div>
</div>
{% endblock %}
