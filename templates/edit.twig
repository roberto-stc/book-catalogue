{% extends 'base.twig' %}
{% block title %}Edit a Book{% endblock %}
{% block content %}
    
<h1>Edit a Book</h1>

<p>{{ message }}</p>
    
<form method="post">
<p>Title: <input type="text" name="title" value="{{ book.title }}"></p>
<p>Author: <input type="text" name="author" value="{{ book.author }}"></p>
<p>Genre: <input type="text" name="genre" value="{{ book.genre }}"></p>
<p>Year: <input type="number" name="year" value="{{ book.year }}"></p>
<p><button type="submit">Save</button></p>
</form>
    
<p><a href="index.php">Back to the book list</a></p>
{% endblock %}
