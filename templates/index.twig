{% extends 'base.twig' %}
{% block content %}
    
<h1>Book Catalogue</h1>
<p><a href="logout.php">Log out</a></p>
    
<p><a href="search.php">Search books</a></p>

<p><a href="add.php">Add a book</a></p>

<table border="1">
        
<tr>        
<th>Title</th>
<th>Author</th>
<th>Genre</th>
<th>Year</th>
<th>Edit</th>
<th>Delete</th> 
</tr>

{% for book in books %}

<tr>          
<td>{{ book.title }}</td>
<td>{{ book.author }}</td>
<td>{{ book.genre }}</td>
<td>{{ book.year }}</td>
<td><a href="edit.php?id={{ book.id }}">Edit</a></td>
<td><a href="delete.php?id={{ book.id }}">Delete</a></td>       
</tr>
        
{% endfor %}
    
</table>
{% endblock %}
