{% extends 'base.twig' %}
{% block title %}Log in{% endblock %}
{% block nav %}{% endblock %}
{% block content %}

<div class="row justify-content-center mt-5">
<div class="col-md-6 col-lg-4">
<div class="card p-4">

<h1 class="h3 mb-3 text-center">Log in</h1>

{% if message %}
<div class="alert alert-warning">{{ message|e }}</div>
{% endif %}
<form method="post">
<div class="mb-3">
<label class="form-label" for="username">Username</label>
<input class="form-control" type="text" id="username" name="username">
</div>
<div class="mb-3">
<label class="form-label" for="password">Password</label>
<input class="form-control" type="password" id="password" name="password">
</div>
<div class="mb-4">
<label class="form-label" for="captcha">What is {{ num1|e }} + {{ num2|e }}?</label>
<input class="form-control" type="number" id="captcha" name="captcha">
</div>
<button class="btn btn-primary w-100" type="submit">Log in</button>
</form>

<p class="text-center mt-3 mb-0"><a href="register.php">No account yet? Register</a></p>

</div>
</div>
</div>
{% endblock %}
