{% extends 'base.twig' %}
{% block title %}Search Books{% endblock %}
{% block content %}
    
<h1>Search Books</h1>
    
<h2>Live search by title</h2>
<input type="text" id="live-title" placeholder="Start typing a title...">
<p id="live-message"></p>
<table border="1">
<tr>
<th>Title</th>
<th>Author</th>
<th>Genre</th>
<th>Year</th>
</tr>
<tbody id="live-results"></tbody>

</table>
<form method="get" action="search.php">
        
<label>Genre:</label>
<input type="text" name="genre" value="{{ genre|e('html_attr') }}">
        
<label>Year:</label>
<input type="text" name="year" value="{{ year|e('html_attr') }}">
        
<button type="submit">Search</button>
</form>
    
<h2>Results</h2>
    
{% if books|length == 0 %}
        
<p>No books found.</p>
{% endif %}
    
<table border="1">
        
<tr>       
<th>Title</th> 
<th>Author</th>
<th>Genre</th>
<th>Year</th>   
</tr>
        
{% for book in books %}
            
<tr>
<td>{{ book.title|e }}</td>
<td>{{ book.author|e }}</td>
<td>{{ book.genre|e }}</td>
<td>{{ book.year|e }}</td>
</tr>
        
{% endfor %}
    
</table>
    
<p><a href="index.php">Back to all books</a></p>
<!-- personal note: the live search JavaScript (with the fetch) is in its own file -->
<script src="live-search.js"></script>
{% endblock %}